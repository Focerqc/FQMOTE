// Firmware owns the game state; positions are 100x100 playfield units mapped onto the panel.
// Holes zigzag down the middle so they stay inside a round panel's circle.

import { Theme } from "theme.slint";
import { AppButton } from "app-button.slint";

export struct WhackHole {
    // 0 = in the hole .. 1 = fully out
    pop: float,
    // 0 = baguette, 1 = golden baguette, 2 = croissant (don't), 3 = wine (a life back),
    // 4 = gold wine (three lives back)
    kind: int,
    bonked: bool,
    // Sideways offset in playfield units while it runs for the edge, 0 in the hole
    run: float,
    // Alternates while running, for the legs and the bounce
    step: bool,
    // Beret colour for bread (see beret-color()), wine style for a bottle (see wine-color())
    style: int,
    // Crust for a plain baguette: 0 pale, 1 golden, 2 well done
    bake: int,
    stache: bool,
}

// Paris park at night around the play area. Landmarks are embedded SVGs: Slint walks every element
// every frame, and drawn from rectangles the scenery alone was ~430 of them. Sizes are rounded to
// whole pixels so the textures, rasterized for a 466 px panel, draw without resampling there.
component WhackScenery inherits Rectangle {
    property <length> ux: self.width / 100;
    property <length> uy: self.height / 100;

    pure function px(units: float) -> length {
        return Math.round(units * root.ux / 1px) * 1px;
    }
    pure function py(units: float) -> length {
        return Math.round(units * root.uy / 1px) * 1px;
    }

    // Mowed lawn stripes
    for b in 7: Rectangle {
        x: 0;
        y: (b * 16 + 8) * root.uy;
        width: root.width;
        height: 8 * root.uy;
        background: #1a3721;
    }

    // Moon with a soft halo, and stars either side of the score
    Rectangle { x: 67 * root.ux; y: 5 * root.uy; width: 12 * root.ux; height: self.width; border-radius: self.width * 0.5; background: #f3e9c612; }
    Rectangle { x: 69 * root.ux; y: 7 * root.uy; width: 8 * root.ux; height: self.width; border-radius: self.width * 0.5; background: #f3e9c61c; }
    Image { x: root.px(70); y: root.py(8); width: root.px(6); height: root.py(6); source: @image-url("../assets/whack/moon.svg"); }
    for st in [{x: 33, y: 7}, {x: 21, y: 19}, {x: 83, y: 16}, {x: 40, y: 3}]: Rectangle {
        x: st.x * root.ux;
        y: st.y * root.uy;
        width: Math.max(2px, 0.7 * root.ux);
        height: self.width;
        background: #fff6d0;
    }
    for st in [{x: 26, y: 12}, {x: 61, y: 4}]: Rectangle {
        x: st.x * root.ux;
        y: st.y * root.uy;
        width: 2.2 * root.ux;
        height: self.width;

        Rectangle { x: parent.width * 0.4; width: parent.width * 0.2; height: parent.height; background: #fff6d0; }
        Rectangle { y: parent.height * 0.4; width: parent.width; height: parent.height * 0.2; background: #fff6d0; }
    }

    // Eiffel Tower: iron with the lattice cut out, then its lit beams, platforms and sparkles
    Image { x: root.px(5); y: root.py(21); width: root.px(18); height: root.py(44); source: @image-url("../assets/whack/tower-iron.svg"); colorize: #a9823a; }
    Image { x: root.px(5); y: root.py(21); width: root.px(18); height: root.py(44); source: @image-url("../assets/whack/tower-lit.svg"); colorize: #f0cd68; }

    Image { x: root.px(77); y: root.py(38); width: root.px(17); height: root.py(13); source: @image-url("../assets/whack/arc.svg"); }

    // Street lamps; the image includes the glow, so it starts up and left of the post
    Image { x: root.px(83.5); y: root.py(18.6); width: root.px(9); height: root.py(17); source: @image-url("../assets/whack/lamp.svg"); }
    Image { x: root.px(11.5); y: root.py(64.6); width: root.px(9); height: root.py(17); source: @image-url("../assets/whack/lamp.svg"); }

    Image { x: root.px(79); y: root.py(58); width: root.px(13); height: root.py(21); source: @image-url("../assets/whack/guillotine.svg"); }

    for t in [{x: 24, y: 85}, {x: 70, y: 83}, {x: 23, y: 19}, {x: 76, y: 78}, {x: 6, y: 64}]: Image {
        x: root.px(t.x);
        y: root.py(t.y);
        width: root.px(3.5);
        height: root.py(3);
        source: @image-url("../assets/whack/tuft.svg");
    }

    // Tricolore flowers
    Image { x: root.px(9); y: root.py(64); width: root.px(4); height: root.py(5); source: @image-url("../assets/whack/flower-red.svg"); }
    Image { x: root.px(20); y: root.py(80); width: root.px(4); height: root.py(5); source: @image-url("../assets/whack/flower-white.svg"); }
    Image { x: root.px(65); y: root.py(86); width: root.px(4); height: root.py(5); source: @image-url("../assets/whack/flower-blue.svg"); }
    Image { x: root.px(81); y: root.py(80); width: root.px(4); height: root.py(5); source: @image-url("../assets/whack/flower-red.svg"); }
}

export component WhackScreen inherits Rectangle {
    in property <[WhackHole]> holes;
    in property <int> target: 2;
    // 0 = rest, 1 = impact on a loaf, 2 = impact on an empty hole, 3 = recoil
    in property <int> mallet-pose: 0;
    in property <string> score: "0";
    in property <string> best: "0";
    in property <int> lives: 3;
    in property <int> mult: 1;
    in property <string> popup: "";
    in property <int> popup-row: 0;
    // 0 = good, 1 = bad, 2 = a life
    in property <int> popup-tone: 0;
    // 0 = ready, 1 = playing, 2 = game over
    in property <int> game-state: 0;

    callback tick();
    // Whacks the targeted hole
    callback hit();
    callback back();

    background: #16301c;

    property <length> ux: root.width / 100;
    property <length> uy: root.height / 100;
    property <length> hole-w: 22 * root.ux;
    property <length> hole-h: 6 * root.uy;
    property <length> bread-w: 7 * root.ux;
    property <length> bread-h: 13 * root.uy;
    property <length> exit-w: Math.round(root.width * 0.26 / 1px) * 1px;
    property <length> exit-h: Math.round(root.height * 0.10 / 1px) * 1px;
    // Life pips shown: three, growing to five as bonus lives come in
    property <int> life-slots: Math.max(3, root.lives);

    // Classic navy-black, then red, blue, green, burgundy and grey
    pure function beret-color(i: int) -> color {
        return i == 1 ? #c0283a : i == 2 ? #2a55c4 : i == 3 ? #2f7a3c : i == 4 ? #7a1f45 : i == 5 ? #6b6f7a : #1b1b2e;
    }

    // Bottle colours by part: 0 cork, 1 foil, 2 glass, 3 glass edge, 4 label, 5 label band.
    // Styles: 0 red, 1 white, 2 rose, 3 champagne, 4 gold.
    pure function wine-color(style: int, part: int) -> color {
        if (style == 4) {
            return part == 0 ? #fff3b0 : part == 1 ? #fff3b0 : part == 2 ? #e8b820 : part == 3 ? #fff0a0 : part == 4 ? #fff8dc : #b8860b;
        }
        if (style == 1) {
            return part == 0 ? #c9a36a : part == 1 ? #d9b54a : part == 2 ? #a8b85a : part == 3 ? #6f7d33 : part == 4 ? #fbf6e6 : #c9a236;
        }
        if (style == 2) {
            return part == 0 ? #c9a36a : part == 1 ? #e38aa5 : part == 2 ? #f0a7b8 : part == 3 ? #b86a80 : part == 4 ? #ffffff : #d94f7a;
        }
        if (style == 3) {
            return part == 0 ? #2b2b33 : part == 1 ? #e8c25a : part == 2 ? #183a22 : part == 3 ? #0a1d10 : part == 4 ? #1b1b2e : #e8c25a;
        }
        return part == 0 ? #c9a36a : part == 1 ? #7a1f2b : part == 2 ? #1f4a2b : part == 3 ? #0f2616 : part == 4 ? #f1e6c8 : #9b1b30;
    }

    // Crust by bake and part: 0 fill, 1 highlight, 2 shadow, 3 outline
    pure function crust-color(bake: int, part: int) -> color {
        if (bake == 0) {
            return part == 0 ? #e8c48a : part == 1 ? #f6e0b4 : part == 2 ? #c9a066 : #a07a45;
        }
        if (bake == 2) {
            return part == 0 ? #b0702e : part == 1 ? #cf9150 : part == 2 ? #8a5020 : #5e3510;
        }
        return part == 0 ? #d9a05b : part == 1 ? #efc486 : part == 2 ? #b77b3c : #8a5a2b;
    }

    pure function hole-x(i: int) -> length {
        return (i == 1 || i == 3 ? 64 : 36) * root.ux;
    }

    pure function hole-y(i: int) -> length {
        return (28 + 12 * i) * root.uy;
    }

    Timer {
        interval: 33ms;
        running: root.game-state == 1;
        triggered => { root.tick(); }
    }

    // Holds focus so the button's Return whacks instead of pressing Exit
    FocusScope {
        width: 0;
        height: 0;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Return) {
                root.hit();
                return accept;
            }
            reject
        }
    }


    Rectangle {
        width: 100%;
        height: 100%;
        clip: true;

        WhackScenery {
            width: 100%;
            height: 100%;
        }

        // Tricolore under the score
        Rectangle { x: 41 * root.ux; y: 17 * root.uy; width: 6 * root.ux; height: 1 * root.uy; background: #1f4fb4; }
        Rectangle { x: 47 * root.ux; y: 17 * root.uy; width: 6 * root.ux; height: 1 * root.uy; background: #f4f4f4; }
        Rectangle { x: 53 * root.ux; y: 17 * root.uy; width: 6 * root.ux; height: 1 * root.uy; background: #e0313f; }

        for h[i] in root.holes: Rectangle {
            x: root.hole-x(i) - root.hole-w / 2;
            y: root.hole-y(i) - root.bread-h - root.hole-h / 2;
            width: root.hole-w;
            height: root.bread-h + root.hole-h;

            Rectangle {
                x: 0;
                y: root.bread-h;
                width: root.hole-w;
                height: root.hole-h;
                border-radius: self.height * 0.45;
                background: #1a0f07;
                border-width: 2px;
                border-color: (root.game-state == 1 && i == root.target) ? #ffd166 : #6b4a2a;
            }

            bread := Rectangle {
                property <length> line-y: root.bread-h + root.hole-h / 2;
                property <length> body-h: (h.kind == 2 ? 7 * root.uy : h.kind >= 3 ? 12 * root.uy : root.bread-h) * (h.bonked ? 0.62 : 1.0);
                property <length> body-w: h.kind == 2 ? 12 * root.ux : h.kind >= 3 ? 5 * root.ux : root.bread-w * (h.bonked ? 1.3 : 1.0);
                property <length> vis-h: Math.round(h.pop * self.body-h / 1px) * 1px;
                // Only plain baguettes vary their bake; croissants stay golden
                property <int> bake: h.kind == 0 ? h.bake : 1;
                property <color> crust: h.kind == 1 ? #ffd23f : root.crust-color(self.bake, 0);
                property <color> crust-hi: h.kind == 1 ? #fff0a0 : root.crust-color(self.bake, 1);
                property <color> crust-lo: h.kind == 1 ? #e0a820 : root.crust-color(self.bake, 2);
                property <color> edge: h.kind == 1 ? #fff3b0 : root.crust-color(self.bake, 3);
                property <length> eye: Math.round(1.6 * root.ux / 1px) * 1px;
                // Radius of the rounded ends; shading strips stay inside them
                property <length> cap: Math.min(self.width, self.vis-h) * 0.45;

                property <bool> running: h.run != 0 && !h.bonked;

                x: Math.round(((root.hole-w - self.body-w) / 2 + h.run * root.ux) / 1px) * 1px;
                y: self.line-y - self.vis-h - (self.running && h.step ? Math.round(root.uy / 1px) * 1px : 0);
                width: self.body-w;
                height: self.vis-h;

                // Only built while something is out of the hole, and only the parts for its kind:
                // Slint walks every element every frame, hidden or not. Kind changes only at spawn.
                if h.pop > 0: Rectangle {
                    width: bread.width;
                    height: bread.height;

                    if h.kind < 2: Rectangle {
                        visible: bread.vis-h >= 4px;
                        width: 100%;
                        height: 100%;
                        border-radius: bread.cap;
                        background: bread.crust;
                        border-width: 1px;
                        border-color: bread.edge;
                    }

                    // Baguette: shading strips down its length, slashes, eyes and a beret
                    if h.kind < 2: Rectangle {
                        width: 100%;
                        height: 100%;

                        Rectangle {
                            visible: bread.vis-h > bread.cap * 2 + 3px;
                            x: bread.width * 0.14;
                            y: bread.cap;
                            width: Math.max(1px, bread.width * 0.16);
                            height: bread.vis-h - bread.cap * 2;
                            border-radius: self.width * 0.45;
                            background: bread.crust-hi;
                        }
                        Rectangle {
                            visible: bread.vis-h > bread.cap * 2 + 3px;
                            x: bread.width * 0.70;
                            y: bread.cap;
                            width: Math.max(1px, bread.width * 0.16);
                            height: bread.vis-h - bread.cap * 2;
                            border-radius: self.width * 0.45;
                            background: bread.crust-lo;
                        }
                        // Each slash only once there's room below it
                        for s in [0.42, 0.62, 0.82]: Rectangle {
                            visible: bread.vis-h > bread.body-h * s + 2 * root.uy;
                            x: bread.width * 0.25;
                            y: bread.body-h * s;
                            width: bread.width * 0.5;
                            height: Math.round(1.2 * root.uy / 1px) * 1px;
                            border-radius: Math.min(self.width, self.height) * 0.45;
                            background: #f3d19c;
                        }
                        // Eyes, squeezed shut when bonked
                        for ex in [0.18, 0.58]: Rectangle {
                            visible: bread.vis-h > bread.body-h * 0.18 + bread.eye + 1px;
                            x: bread.width * ex;
                            y: bread.body-h * 0.18 + (h.bonked ? bread.eye / 2 : 0);
                            width: bread.eye;
                            height: h.bonked ? 1px : bread.eye;
                            border-radius: h.bonked ? 0 : bread.eye * 0.45;
                            background: #1b1208;
                        }
                        Rectangle {
                            visible: bread.vis-h > 2 * root.uy;
                            x: -bread.width * 0.1;
                            y: -1.4 * root.uy;
                            width: bread.width * 1.2;
                            height: Math.round(2.6 * root.uy / 1px) * 1px;
                            border-radius: Math.min(self.width, self.height) * 0.45;
                            background: root.beret-color(h.style);
                        }
                        Rectangle {
                            visible: bread.vis-h > 2 * root.uy;
                            x: bread.width * 0.44;
                            y: -2.4 * root.uy;
                            width: bread.width * 0.14;
                            height: 1.4 * root.uy;
                            background: root.beret-color(h.style);
                        }
                        // Moustache: two thick lobes parted under the nose, tapering out and drooping
                        // at the ends (ends that turn up read as a grin)
                        if h.stache: Rectangle {
                            visible: bread.vis-h > bread.body-h * 0.38;
                            property <length> thick: Math.max(3px, Math.round(1.9 * root.uy / 1px) * 1px);

                            for lobe in [{x: 0.24, y: 0.0, w: 0.28, h: 1.0}, {x: 0.48, y: 0.0, w: 0.28, h: 1.0}, {x: 0.08, y: 0.35, w: 0.22, h: 0.7}, {x: 0.70, y: 0.35, w: 0.22, h: 0.7}]: Rectangle {
                                x: bread.width * lobe.x;
                                y: bread.body-h * 0.30 + parent.thick * lobe.y;
                                width: bread.width * lobe.w;
                                height: parent.thick * lobe.h;
                                border-radius: Math.min(self.width, self.height) * 0.5;
                                background: #2a1a0e;
                            }
                            // Parting
                            Rectangle {
                                x: bread.width * 0.5 - 0.5px;
                                y: bread.body-h * 0.30;
                                width: 1px;
                                height: parent.thick * 0.5;
                                background: bread.crust;
                            }
                        }
                    }

                    // Croissant: a crescent of rolled segments, the tips curling lower, each outlined so
                    // the layers show. Stretches with the rise like the loaf does.
                    if h.kind == 2: Rectangle {
                        visible: bread.vis-h >= 6px;
                        width: 100%;
                        height: 100%;

                        for seg in [{x: 0.00, y: 0.46, w: 0.20, h: 0.40}, {x: 0.80, y: 0.46, w: 0.20, h: 0.40}, {x: 0.12, y: 0.22, w: 0.28, h: 0.64}, {x: 0.60, y: 0.22, w: 0.28, h: 0.64}, {x: 0.32, y: 0.04, w: 0.36, h: 0.90}]: Rectangle {
                            x: bread.width * seg.x;
                            y: bread.vis-h * seg.y;
                            width: bread.width * seg.w;
                            height: bread.vis-h * seg.h;
                            border-radius: Math.min(self.width, self.height) * 0.45;
                            background: bread.crust;
                            border-width: 1px;
                            border-color: #8a5a2b;
                        }
                        // Sheen on the fat middle
                        Rectangle {
                            x: bread.width * 0.40;
                            y: bread.vis-h * 0.14;
                            width: bread.width * 0.2;
                            height: Math.max(1px, bread.vis-h * 0.14);
                            border-radius: self.height * 0.45;
                            background: bread.crust-hi;
                        }
                        for ex in [0.40, 0.54]: Rectangle {
                            visible: bread.vis-h > bread.body-h * 0.5;
                            x: bread.width * ex;
                            y: bread.vis-h * 0.40 + (h.bonked ? bread.eye / 2 : 0);
                            width: bread.eye;
                            height: h.bonked ? 1px : bread.eye;
                            border-radius: h.bonked ? 0 : bread.eye * 0.45;
                            background: #1b1208;
                        }
                    }

                    // Wine bottle: cork, foil neck, shoulders, body with a label and a glint
                    if h.kind >= 3: bottle := Rectangle {
                        width: 100%;
                        height: 100%;
                        property <int> wine: h.kind == 4 ? 4 : h.style;

                        Rectangle { visible: bread.vis-h > 2px; x: bread.width * 0.36; y: 0; width: bread.width * 0.28; height: Math.min(bread.vis-h, bread.body-h * 0.08); background: root.wine-color(bottle.wine, 0); }
                        Rectangle { visible: bread.vis-h > bread.body-h * 0.08; x: bread.width * 0.34; y: bread.body-h * 0.08; width: bread.width * 0.32; height: Math.min(bread.vis-h - bread.body-h * 0.08, bread.body-h * 0.26); background: root.wine-color(bottle.wine, 1); }
                        Rectangle {
                            visible: bread.vis-h > bread.body-h * 0.30;
                            y: bread.body-h * 0.30;
                            width: bread.width;
                            height: bread.vis-h - bread.body-h * 0.30;
                            border-radius: Math.min(self.width, self.height) * 0.3;
                            background: root.wine-color(bottle.wine, 2);
                            border-width: 1px;
                            border-color: root.wine-color(bottle.wine, 3);

                            Rectangle { visible: parent.height > root.uy * 4; x: parent.width * 0.1; y: parent.height * 0.3; width: parent.width * 0.8; height: parent.height * 0.36; background: root.wine-color(bottle.wine, 4); }
                            Rectangle { visible: parent.height > root.uy * 4; x: parent.width * 0.1; y: parent.height * 0.42; width: parent.width * 0.8; height: parent.height * 0.1; background: root.wine-color(bottle.wine, 5); }
                            Rectangle { x: parent.width * 0.16; y: parent.height * 0.08; width: Math.max(1px, parent.width * 0.14); height: parent.height * 0.18; border-radius: self.width * 0.45; background: h.kind == 4 ? #ffffffa0 : #ffffff40; }
                        }
                    }

                    // Legs, scissoring while it runs
                    if bread.running: Rectangle {
                        width: 100%;
                        height: 100%;

                        for leg in [0, 1]: Rectangle {
                            x: bread.width * (leg == 0 ? 0.2 : 0.62);
                            y: bread.height;
                            width: Math.max(2px, Math.round(bread.width * 0.18 / 1px) * 1px);
                            height: Math.round(((leg == 0) == h.step ? 2.6 : 1.4) * root.uy / 1px) * 1px;
                            background: #1b1208;
                        }
                    }
                }
            }
        }

        // Mallet. Cocked beside the target so the holes stay clear, then slams straight down and
        // bounces back up. Discrete poses rather than animations: an animation re-rendered the
        // whole sweep every frame and lagged the stick.
        mallet := Rectangle {
            visible: root.game-state == 1;
            width: 100%;
            height: 100%;

            property <float> side: (root.target == 0 || root.target == 2 || root.target == 4) ? 1 : -1;
            property <length> tx: root.hole-x(root.target);
            property <length> ty: root.hole-y(root.target);
            property <int> pose: root.mallet-pose;
            property <bool> impact: self.pose == 1 || self.pose == 2;

            // Head centre per pose: cocked and raised, down on the squashed loaf, down on the rim,
            // bounced up high. Rest stays clear of the score on the top row.
            property <length> hx: self.tx + self.side * (self.impact ? 1 : (self.pose == 3 ? 7 : 14)) * root.ux;
            property <length> hy: self.pose == 1 ? self.ty - 11.5 * root.uy
                : self.pose == 2 ? self.ty - 5.5 * root.uy
                : Math.max(15 * root.uy, self.ty - (self.pose == 3 ? 16 : 9) * root.uy);
            // Handle direction away from the head: steep while cocked, flat on impact
            property <float> dx: self.side * (self.impact ? 0.97 : (self.pose == 3 ? 0.7 : 0.42));
            property <float> dy: self.impact ? 0.12 : (self.pose == 3 ? 0.6 : 0.9);
            // The head squashes wide and flat as it lands
            property <length> head-w: (self.impact ? 12.5 : 11) * root.ux;
            property <length> head-h: (self.impact ? 5.6 : 7) * root.ux;

            // Overlapping round segments keep the diagonal handle smooth without rotation
            for seg in 6: Rectangle {
                x: parent.hx + parent.dx * (2.8 + seg * 1.9) * root.ux - self.width / 2;
                y: parent.hy + parent.dy * (2.8 + seg * 1.9) * root.ux - self.height / 2;
                width: (seg >= 4 ? 2.6 : 2.3) * root.ux;
                height: self.width;
                border-radius: self.width * 0.5;
                background: seg >= 4 ? #5e3a19 : #c89a5a;
            }

            // Barrel head with a tricolore band
            Rectangle {
                x: parent.hx - parent.head-w / 2;
                y: parent.hy - parent.head-h / 2;
                width: parent.head-w;
                height: parent.head-h;
                border-radius: self.height * 0.3;
                background: #9a6a36;
                border-width: 1px;
                border-color: #4a2c12;

                Rectangle { x: parent.width * 0.30; y: 1px; width: parent.width * 0.14; height: parent.height - 2px; background: #1f4fb4; }
                Rectangle { x: parent.width * 0.44; y: 1px; width: parent.width * 0.14; height: parent.height - 2px; background: #f4f4f4; }
                Rectangle { x: parent.width * 0.58; y: 1px; width: parent.width * 0.14; height: parent.height - 2px; background: #e0313f; }
                Rectangle { x: parent.width * 0.1; y: parent.height * 0.16; width: parent.width * 0.8; height: Math.max(1px, parent.height * 0.12); border-radius: self.height * 0.45; background: #ffffff38; }
            }

            // Smack lines on a hit, a dust puff on a miss, both where the head lands. Built only
            // while shown.
            if mallet.pose == 1: Rectangle {
                for ln in [{x: -1, y: 0.1, w: 3.6, h: 0.9}, {x: 1, y: 0.1, w: 3.6, h: 0.9}, {x: -0.8, y: -0.7, w: 2.4, h: 0.8}, {x: 0.8, y: -0.7, w: 2.4, h: 0.8}]: Rectangle {
                    x: mallet.hx + ln.x * (mallet.head-w / 2 + 1.2 * root.ux) - (ln.x < 0 ? self.width : 0);
                    y: mallet.hy + mallet.head-h / 2 + ln.y * 3 * root.ux - self.height / 2;
                    width: ln.w * root.ux;
                    height: Math.max(2px, ln.h * root.ux);
                    border-radius: self.height * 0.45;
                    background: #fff3b0;
                }
            }
            if mallet.pose == 2: Rectangle {
                for pf in [{x: -5.5, s: 2.6}, {x: -2.2, s: 3.2}, {x: 2.2, s: 3.2}, {x: 5.5, s: 2.6}]: Rectangle {
                    x: mallet.tx + pf.x * root.ux - self.width / 2;
                    y: mallet.ty - self.height * 0.8;
                    width: pf.s * root.ux;
                    height: self.width;
                    border-radius: self.width * 0.5;
                    background: #c8bfae99;
                }
            }
        }

        Text {
            visible: root.popup != "";
            x: root.hole-x(root.popup-row) - 22 * root.ux;
            y: root.popup-row == 4 ? root.hole-y(4) - root.bread-h - 8 * root.uy : root.hole-y(root.popup-row) + 3 * root.uy;
            width: 44 * root.ux;
            text: root.popup;
            color: root.popup-tone == 1 ? Theme.color-critical : root.popup-tone == 2 ? #7fe08a : #ffd166;
            font-size: Theme.font-14;
            font-weight: Theme.w-semibold;
            horizontal-alignment: center;
        }

        Text {
            x: 0;
            y: 2 * root.uy;
            width: 100%;
            text: root.score;
            color: #fff6e0;
            font-family: "JetBrains Mono";
            font-size: Theme.font-28;
            font-weight: Theme.w-semibold;
            horizontal-alignment: center;
        }

        // Lives as little loaves
        for n in 5: Rectangle {
            visible: n < root.life-slots;
            x: (50 - (root.life-slots * 5 - 2) / 2 + 5 * n) * root.ux;
            y: 20 * root.uy;
            width: 3 * root.ux;
            height: 1.6 * root.uy;
            border-radius: self.height * 0.45;
            background: n < root.lives ? #d9a05b : #ffffff26;
        }

        if root.mult > 1: Text {
            x: (51 + root.life-slots * 2.5) * root.ux;
            y: 18.5 * root.uy;
            text: "x" + root.mult;
            color: #ffd166;
            font-size: Theme.font-11;
            font-weight: Theme.w-semibold;
        }
    }

    if root.game-state == 0: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000d9;

        VerticalLayout {
            alignment: center;
            spacing: Math.round(3px * Theme.scale / 1px) * 1px;
            padding-left: Theme.page-padding-horizontal;
            padding-right: Theme.page-padding-horizontal;
            padding-bottom: root.exit-h;

            Text {
                text: "WHACK-A-BAGUETTE";
                color: #ffd166;
                font-size: Theme.font-14;
                font-weight: Theme.w-semibold;
                horizontal-alignment: center;
            }

            Rectangle { height: Math.round(6px * Theme.scale / 1px) * 1px; }

            Text {
                text: "Stick aims, button whacks";
                color: #ffd166;
                font-size: Theme.font-10;
                horizontal-alignment: center;
            }

            Text {
                text: "Gold is worth 5. Spare the croissants";
                color: Theme.text-dim;
                font-size: Theme.font-10;
                horizontal-alignment: center;
                wrap: word-wrap;
            }

            Text {
                text: "Wine buys back a life";
                color: Theme.text-dim;
                font-size: Theme.font-10;
                horizontal-alignment: center;
            }

            Rectangle { height: Math.round(8px * Theme.scale / 1px) * 1px; }

            Text {
                text: "BEST " + root.best;
                color: Theme.text-dim;
                font-size: Theme.font-11;
                horizontal-alignment: center;
            }

            Text {
                text: "PRESS TO START";
                color: Theme.text;
                font-size: Theme.font-12;
                font-weight: Theme.w-semibold;
                horizontal-alignment: center;
            }
        }
    }

    if root.game-state == 2: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000d9;

        VerticalLayout {
            alignment: center;
            spacing: Math.round(2px * Theme.scale / 1px) * 1px;
            padding-left: Theme.page-padding-horizontal;
            padding-right: Theme.page-padding-horizontal;
            padding-bottom: root.exit-h;

            Text {
                text: "OUT OF BREAD";
                color: Theme.color-critical;
                font-size: Theme.font-14;
                font-weight: Theme.w-semibold;
                horizontal-alignment: center;
            }

            Rectangle { height: Math.round(8px * Theme.scale / 1px) * 1px; }

            Text {
                text: "SCORE";
                color: Theme.text-dim;
                font-size: Theme.font-10;
                horizontal-alignment: center;
            }

            Text {
                text: root.score;
                color: Theme.text;
                font-family: "JetBrains Mono";
                font-size: Theme.font-28;
                horizontal-alignment: center;
            }

            Text {
                text: "BEST " + root.best;
                color: Theme.text-dim;
                font-size: Theme.font-11;
                horizontal-alignment: center;
            }

            Rectangle { height: Math.round(10px * Theme.scale / 1px) * 1px; }

            Text {
                text: "PRESS TO RETRY";
                color: Theme.text;
                font-size: Theme.font-12;
                font-weight: Theme.w-semibold;
                horizontal-alignment: center;
            }
        }
    }

    AppButton {
        x: (root.width - self.width) / 2;
        y: Math.round(root.height * 0.96 / 1px) * 1px - self.height;
        width: root.exit-w;
        height: root.exit-h;
        text: "Exit";
        variant: "secondary";
        size: "small";
        clicked => { root.back(); }
    }
}
